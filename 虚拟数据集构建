def huber_loss_np(y_true, y_pred, delta=1.0):
    err = y_true - y_pred
    abs_err = np.abs(err)
    quad = np.minimum(abs_err, delta)
    return np.mean(0.5 * quad**2 + delta * (abs_err - quad))

def metrics_dict(y_true, y_pred):
    mse = mean_squared_error(y_true, y_pred)
    rmse = float(np.sqrt(mse))
    pr, pp = stats.pearsonr(np.array(y_true), np.array(y_pred))
    return {
        "R2": r2_score(y_true, y_pred),
        "MSE": mse,
        "RMSE": rmse,
        "MAE": mean_absolute_error(y_true, y_pred),
        "MAPE": mean_absolute_percentage_error(y_true, y_pred),
        "Pearson_r": pr,
        "Pearson_p": pp,
        "Huber(delta=1.0)": huber_loss_np(np.array(y_true), np.array(y_pred), delta=1.0),
    }

def centers_to_edges(vals):
    vals = np.asarray(vals, dtype=float)
    if len(vals) == 1:
        return np.array([vals[0] - 0.5, vals[0] + 0.5], dtype=float)
    d = np.diff(vals)
    edges = np.empty(len(vals) + 1, dtype=float)
    edges[1:-1] = vals[:-1] + d / 2.0
    edges[0] = vals[0] - d[0] / 2.0
    edges[-1] = vals[-1] + d[-1] / 2.0
    return edges

def interpolate_for_contour(x_vals, y_vals, Z, fine_n=300):
    x_vals = np.asarray(x_vals, float)
    y_vals = np.asarray(y_vals, float)
    Z = np.asarray(Z, float)

    if (not SPLINE_OK) or (len(x_vals) < 2) or (len(y_vals) < 2):
        return x_vals, y_vals, Z

    nx = len(x_vals)
    ny = len(y_vals)
    kx = min(3, nx - 1)
    ky = min(3, ny - 1)
    if kx < 1 or ky < 1:
        return x_vals, y_vals, Z

    # spline 输入Z需要转置：Z.T
    spline = RectBivariateSpline(x_vals, y_vals, Z.T, kx=kx, ky=ky)

    x_f = np.linspace(x_vals.min(), x_vals.max(), fine_n)
    y_f = np.linspace(y_vals.min(), y_vals.max(), fine_n)
    Z_f = spline(x_f, y_f).T
    return x_f, y_f, Z_f


def plot_fusion_fit(y_train, y_train_pred, y_test, y_test_pred, save_path):
    """
    预测拟合效果图：Observation vs Prediction（Train/Test）
    """
    y_train = np.asarray(y_train).ravel()
    y_train_pred = np.asarray(y_train_pred).ravel()
    y_test = np.asarray(y_test).ravel()
    y_test_pred = np.asarray(y_test_pred).ravel()

    all_y = np.concatenate([y_train, y_test])
    all_p = np.concatenate([y_train_pred, y_test_pred])
    vmin = float(min(all_y.min(), all_p.min()))
    vmax = float(max(all_y.max(), all_p.max()))
    pad = 0.02 * (vmax - vmin + 1e-12)
    vmin -= pad
    vmax += pad

    mtr = metrics_dict(y_train, y_train_pred)
    mte = metrics_dict(y_test, y_test_pred)

    fig = plt.figure(figsize=(8.4, 7.6))
    ax = fig.add_axes([0.12, 0.12, 0.83, 0.80])

    ax.scatter(y_train, y_train_pred, s=22, alpha=0.75, label=f"Train (R2={mtr['R2']:.3f}, RMSE={mtr['RMSE']:.3g})")
    ax.scatter(y_test,  y_test_pred,  s=22, alpha=0.75, label=f"Test  (R2={mte['R2']:.3f}, RMSE={mte['RMSE']:.3g})")

    ax.plot([vmin, vmax], [vmin, vmax], "k--", lw=1.6)
    ax.set_xlim(vmin, vmax)


    ax.set_xlabel("Observation (IICE)", fontsize=16, fontweight="bold")
    ax.set_ylabel("Prediction (FUSION)", fontsize=16, fontweight="bold")
    ax.set_title("FUSION Model Fit: Observation vs Prediction", fontsize=15, fontweight="bold")

    ax.tick_params(direction="in", length=6, width=1.2, labelsize=12)
    ax.minorticks_on()
    ax.tick_params(which="minor", direction="in", length=3, width=1.0)
    for sp in ax.spines.values():
        sp.set_linewidth(1.3)

    ax.legend(frameon=False, fontsize=11, loc="best")

    plt.savefig(save_path, dpi=600, bbox_inches="tight")
    plt.close()
    print("[Done] Saved fusion fit plot ->", save_path)


