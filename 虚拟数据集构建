def build_ada(seed=5):
    base = DecisionTreeRegressor(
        max_depth=4,
        min_samples_split=2,
        min_samples_leaf=3,
        random_state=seed
    )
    try:
        return AdaBoostRegressor(
            estimator=base,
            n_estimators=500,
            learning_rate=0.1,
            loss="square",
            random_state=seed
        )
    except TypeError:
        return AdaBoostRegressor(
            base_estimator=base,
            n_estimators=500,
            learning_rate=0.1,
            loss="square",
            random_state=seed
        )

def build_cat(seed=5):
