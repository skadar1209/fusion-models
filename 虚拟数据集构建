    for ep in range(600):
        opt.zero_grad()
        pred, _ = fusion_net(X_fuse_train)
        loss = crit(pred, y_train_t)
        loss.backward()
        opt.step()
        if (ep + 1) % 150 == 0:
            print(f"[Fusion] Epoch {ep+1}/600 | loss={loss.item():.6f}")
    torch.save(fusion_net.state_dict(), FUSION_PT_PATH)
    print("[Done] Saved FusionNet:", FUSION_PT_PATH)

fusion_net.eval()

def fusion_predict_from_raw(X_raw: pd.DataFrame, batch_size=200000) -> np.ndarray:
    X_std = scaler.transform(X_raw[features].values)
    N = X_std.shape[0]
    out = np.zeros((N,), dtype=float)

    for s in range(0, N, batch_size):
        e = min(N, s + batch_size)
        xs = X_std[s:e]

        pred_list = [mdl.predict(xs) for _, mdl in base_models]
        preds = np.vstack(pred_list).T  # (B, M)

        with torch.no_grad():
            fused, _ = fusion_net(torch.tensor(preds, dtype=torch.float32))
        out[s:e] = fused.numpy()

    return out


