y_train_t = torch.tensor(y_train.values, dtype=torch.float32)

crit = nn.SmoothL1Loss()
opt = optim.Adam(fusion_net.parameters(), lr=1e-3, weight_decay=1e-4)

if LOAD_EXISTING and os.path.exists(FUSION_PT_PATH):
