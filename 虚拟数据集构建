def auto_find_virtual_csv(out_dir: str):
    cands = []
    patterns = [
        os.path.join(out_dir, "*discrete*points*.csv"),
        os.path.join(out_dir, "*virtual*points*.csv"),
        os.path.join(out_dir, "*Fig5*points*.csv"),
        os.path.join(out_dir, "*.csv"),
    ]
    for p in patterns:
        cands.extend(glob.glob(p))
    cands = list(dict.fromkeys(cands))

    best = None
    best_score = -1
    for fp in cands:
        try:
            df_tmp = pd.read_csv(fp)
            n = len(df_tmp)
            score = 0
            name = os.path.basename(fp).lower()
            if "discrete" in name: score += 5
            if "virtual" in name: score += 5
            if "points" in name: score += 3
            if "fig5" in name: score += 2
            if 4000 <= n <= 20000: score += 3
            if all(col in df_tmp.columns for col in features): score += 10
            if score > best_score:
                best_score = score
                best = fp
        except Exception:
            continue
    return best


